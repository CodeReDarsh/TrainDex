# Public client (Vite). Required for the browser Supabase client.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server (TanStack Start / Nitro). Same project as the VITE_ values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only used by src/integrations/supabase/cron-auth.ts.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
